{
    "$schema": "https://raw.githubusercontent.com/QuadrantSynergyInternational/form-schema/refs/heads/main/schema.json",
    "$params": {
        "type": "form",
        "productCode": "TEST",
        "productName": "Test Product",
        "productType": "TR",
        "productTypeName": "Traditional",
        "productFormCode": "TESTFORM",
        "riplayTemplates": [
            "TEST"
        ],
        "constants": {
            "MAX_AGE": 100,
            "MIN_AGE": {
                "$evaluation": {
                    "-": [
                        100,
                        {
                            "$ref": "#/form/properties/user/properties/age"
                        }
                    ]
                }
            }
        },
        "references": {
            "PRODUCT_TYPES": [
                {
                    "TYPE": "Basic",
                    "CODE": "B1"
                },
                {
                    "TYPE": "Advanced",
                    "CODE": "P1"
                }
            ],
            "RATES": [
                {
                    "AGE": 20,
                    "MALE_RATE": 1.5,
                    "FEMALE_RATE": 1.2,
                    "SMOKER_MULTIPLIER": 1.5
                },
                {
                    "AGE": 30,
                    "MALE_RATE": 2.0,
                    "FEMALE_RATE": 1.8,
                    "SMOKER_MULTIPLIER": 1.6
                },
                {
                    "AGE": 40,
                    "MALE_RATE": 3.5,
                    "FEMALE_RATE": 3.0,
                    "SMOKER_MULTIPLIER": 1.8
                },
                {
                    "AGE": 50,
                    "MALE_RATE": 5.5,
                    "FEMALE_RATE": 4.8,
                    "SMOKER_MULTIPLIER": 2.0
                }
            ],
            "OCCUPATION_TABLE": [
                {
                    "OCC_CODE": "OFFICE",
                    "OCC_DESC": "Office Worker",
                    "OCC_CLASS": "1",
                    "RISK_LEVEL": "Low"
                },
                {
                    "OCC_CODE": "MANUAL",
                    "OCC_DESC": "Manual Labor",
                    "OCC_CLASS": "2",
                    "RISK_LEVEL": "Medium"
                },
                {
                    "OCC_CODE": "PROFESSIONAL",
                    "OCC_DESC": "Professional",
                    "OCC_CLASS": "1",
                    "RISK_LEVEL": "Low"
                },
                {
                    "OCC_CODE": "HIGH_RISK",
                    "OCC_DESC": "High Risk Occupation",
                    "OCC_CLASS": "3",
                    "RISK_LEVEL": "High"
                }
            ]
        }
    },
    "form": {
        "type": "object",
        "$layout": {
            "type": "VerticalLayout",
            "elements": [
                {
                    "$ref": "#/form/properties/header"
                },
                {
                    "$ref": "#/form/properties/user"
                },
                {
                    "$ref": "#/form/properties/details"
                }
            ]
        },
        "properties": {
            "header": {
                "type": "object",
                "$layout": {
                    "type": "FlexLayout",
                    "template": "FormHeader",
                    "elements": [
                        {
                            "$ref": "#/form/properties/header/properties/form_number"
                        },
                        {
                            "$ref": "#/form/properties/header/properties/form_date"
                        },
                        {
                            "$ref": "#/form/properties/header/properties/extra_comments"
                        },
                        {
                            "$ref": "#/form/properties/header/properties/recursive_test"
                        }
                    ]
                },
                "properties": {
                    "form_number": {
                        "type": "string",
                        "title": "Form Number",
                        "fieldType": "textinput",
                        "condition": {
                            "disabled": true
                        },
                        "rules": {
                            "maxLength": {
                                "value": 15,
                                "message": "Max 15 characters"
                            }
                        }
                    },
                    "form_date": {
                        "type": "string",
                        "title": "Form Date",
                        "fieldType": "datepicker",
                        "condition": {
                            "disabled": true
                        },
                        "value": {
                            "$evaluation": {
                                "NOW": []
                            }
                        }
                    },
                    "recursive_test": {
                        "type": "object",
                        "title": "Recursive Test",
                        "$layout": {
                            "type": "VerticalLayout",
                            "elements": [
                                {
                                    "$ref": "#/form/properties/header/properties/recursive_test/properties/field_c"
                                },
                                {
                                    "$ref": "#/form/properties/header/properties/recursive_test/properties/field_b"
                                },
                                {
                                    "$ref": "#/form/properties/header/properties/recursive_test/properties/field_a"
                                }
                            ]
                        },
                        "properties": {
                            "field_c": {
                                "type": "boolean",
                                "title": "Field C",
                                "fieldType": "checkbox"
                            },
                            "field_b": {
                                "type": "boolean",
                                "title": "Field B",
                                "fieldType": "checkbox",
                                "condition": {
                                    "hidden": {
                                        "$evaluation": {
                                            "==": [
                                                {
                                                    "$ref": "#/form/properties/header/properties/recursive_test/properties/field_c"
                                                },
                                                true
                                            ]
                                        }
                                    }
                                }
                            },
                            "field_a": {
                                "type": "string",
                                "title": "Field A",
                                "fieldType": "textinput",
                                "condition": {
                                    "hidden": {
                                        "$evaluation": {
                                            "ISEMPTY": [
                                                {
                                                    "$ref": "#/form/properties/header/properties/recursive_test/properties/field_b"
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "extra_comments": {
                        "type": "string",
                        "title": "Extra Comments",
                        "fieldType": "textarea",
                        "condition": {
                            "hidden": {
                                "$evaluation": {
                                    "==": [
                                        {
                                            "$ref": "#/form/properties/header/properties/form_number"
                                        },
                                        "HIDE"
                                    ]
                                }
                            }
                        },
                        "config": {
                            "all": {
                                "keepHiddenValue": true
                            }
                        }
                    }
                }
            },
            "user": {
                "type": "object",
                "title": "User Profile",
                "$layout": {
                    "type": "VerticalLayout",
                    "elements": [
                        {
                            "$ref": "#/form/properties/user/properties/name"
                        },
                        {
                            "$ref": "#/form/properties/user/properties/date_of_birth"
                        },
                        {
                            "$ref": "#/form/properties/user/properties/age"
                        },
                        {
                            "$ref": "#/form/properties/user/properties/gender"
                        },
                        {
                            "$ref": "#/form/properties/user/properties/is_smoker"
                        },
                        {
                            "$ref": "#/form/properties/user/properties/occupation"
                        },
                        {
                            "$ref": "#/form/properties/user/properties/occupation_class"
                        },
                        {
                            "$ref": "#/form/properties/user/properties/risk_category"
                        }
                    ]
                },
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Full Name",
                        "fieldType": "textinput",
                        "rules": {
                            "required": {
                                "value": true,
                                "message": "Name is required"
                            }
                        }
                    },
                    "date_of_birth": {
                        "type": "string",
                        "title": "Date of Birth",
                        "fieldType": "datepicker",
                        "dependents": [
                            {
                                "$ref": "#/form/properties/user/properties/age",
                                "value": {
                                    "$evaluation": {
                                        "DATEDIF": [
                                            {
                                                "$ref": "$value"
                                            },
                                            {
                                                "NOW": []
                                            },
                                            "Y"
                                        ]
                                    }
                                }
                            }
                        ]
                    },
                    "age": {
                        "type": "number",
                        "title": "Age",
                        "fieldType": "numberinput",
                        "rules": {
                            "minValue": {
                                "value": 1,
                                "message": "Age must be at least 1"
                            },
                            "maxValue": {
                                "value": 100,
                                "message": "Age must be at most 100"
                            }
                        }
                    },
                    "gender": {
                        "type": "string",
                        "title": "Gender",
                        "fieldType": "select",
                        "options": [
                            {
                                "label": "Male",
                                "value": "M"
                            },
                            {
                                "label": "Female",
                                "value": "F"
                            }
                        ]
                    },
                    "is_smoker": {
                        "type": "boolean",
                        "title": "Is Smoker?",
                        "fieldType": "checkbox",
                        "dependents": [
                            {
                                "$ref": "#/form/properties/user/properties/occupation",
                                "clear": {
                                    "$evaluation": true
                                }
                            },
                            {
                                "$ref": "#/form/properties/user/properties/risk_category",
                                "value": {
                                    "$evaluation": {
                                        "if": [
                                            {
                                                "$ref": "$value"
                                            },
                                            "High",
                                            "Standard"
                                        ]
                                    }
                                }
                            }
                        ]
                    },
                    "occupation": {
                        "type": "string",
                        "title": "Occupation",
                        "fieldType": "select",
                        "options": [
                            {
                                "label": "Office Worker",
                                "value": "OFFICE"
                            },
                            {
                                "label": "Manual Labor",
                                "value": "MANUAL"
                            },
                            {
                                "label": "Professional",
                                "value": "PROFESSIONAL"
                            },
                            {
                                "label": "High Risk",
                                "value": "HIGH_RISK"
                            }
                        ],
                        "dependents": [
                            {
                                "$ref": "#/form/properties/user/properties/occupation_class",
                                "value": {
                                    "$evaluation": {
                                        "if": [
                                            {
                                                "==": [
                                                    {
                                                        "$ref": "$value"
                                                    },
                                                    "OFFICE"
                                                ]
                                            },
                                            "1",
                                            {
                                                "if": [
                                                    {
                                                        "==": [
                                                            {
                                                                "$ref": "$value"
                                                            },
                                                            "PROFESSIONAL"
                                                        ]
                                                    },
                                                    "1",
                                                    {
                                                        "if": [
                                                            {
                                                                "==": [
                                                                    {
                                                                        "$ref": "$value"
                                                                    },
                                                                    "MANUAL"
                                                                ]
                                                            },
                                                            "2",
                                                            "3"
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        ]
                    },
                    "occupation_class": {
                        "type": "string",
                        "title": "Occupation Class",
                        "fieldType": "textinput",
                        "condition": {
                            "disabled": true
                        },
                        "dependents": [
                            {
                                "$ref": "#/form/properties/user/properties/risk_category",
                                "value": {
                                    "$evaluation": {
                                        "if": [
                                            {
                                                "==": [
                                                    {
                                                        "$ref": "$value"
                                                    },
                                                    "1"
                                                ]
                                            },
                                            "Low",
                                            {
                                                "if": [
                                                    {
                                                        "==": [
                                                            {
                                                                "$ref": "$value"
                                                            },
                                                            "2"
                                                        ]
                                                    },
                                                    "Medium",
                                                    "High"
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        ]
                    },
                    "risk_category": {
                        "type": "string",
                        "title": "Risk Category",
                        "fieldType": "textinput",
                        "condition": {
                            "disabled": true
                        }
                    }
                }
            },
            "details": {
                "type": "object",
                "title": "Details",
                "$layout": {
                    "type": "VerticalLayout",
                    "elements": [
                        {
                            "$ref": "#/form/properties/details/properties/has_additional_option"
                        },
                        {
                            "$ref": "#/form/properties/details/properties/option_type"
                        },
                        {
                            "$ref": "#/form/properties/details/properties/option_details"
                        }
                    ]
                },
                "properties": {
                    "has_additional_option": {
                        "type": "boolean",
                        "title": "Add Additional Option?",
                        "fieldType": "checkbox",
                        "dependents": [
                            {
                                "$ref": "#/form/properties/details/properties/option_type",
                                "clear": {
                                    "$evaluation": {
                                        "if": [
                                            {
                                                "==": [
                                                    {
                                                        "$ref": "$value"
                                                    },
                                                    false
                                                ]
                                            },
                                            true,
                                            false
                                        ]
                                    }
                                }
                            }
                        ]
                    },
                    "option_type": {
                        "type": "string",
                        "title": "Option Type",
                        "fieldType": "select",
                        "options": [
                            {
                                "label": "Standard Option",
                                "value": "STANDARD"
                            },
                            {
                                "label": "Advanced Option",
                                "value": "ADVANCED"
                            },
                            {
                                "label": "Custom Option",
                                "value": "CUSTOM"
                            }
                        ],
                        "condition": {
                            "hidden": {
                                "$evaluation": {
                                    "!=": [
                                        {
                                            "$ref": "#/form/properties/details/properties/has_additional_option"
                                        },
                                        true
                                    ]
                                }
                            },
                            "disabled": {
                                "$evaluation": {
                                    "or": [
                                        {
                                            "ISEMPTY": [
                                                {
                                                    "$ref": "#/form/properties/details/properties/has_additional_option"
                                                }
                                            ]
                                        },
                                        {
                                            "==": [
                                                {
                                                    "$ref": "#/form/properties/details/properties/has_additional_option"
                                                },
                                                false
                                            ]
                                        }
                                    ]
                                }
                            }
                        },
                        "dependents": [
                            {
                                "$ref": "#/form/properties/details/properties/option_details",
                                "clear": {
                                    "$evaluation": true
                                }
                            }
                        ]
                    },
                    "option_details": {
                        "type": "object",
                        "title": "Option Details",
                        "$layout": {
                            "type": "VerticalLayout",
                            "elements": [
                                {
                                    "$ref": "#/form/properties/details/properties/option_details/properties/amount"
                                },
                                {
                                    "$ref": "#/form/properties/details/properties/option_details/properties/fee"
                                },
                                {
                                    "$ref": "#/form/properties/details/properties/option_details/properties/custom_options"
                                }
                            ]
                        },
                        "condition": {
                            "hidden": {
                                "$evaluation": {
                                    "or": [
                                        {
                                            "ISEMPTY": [
                                                {
                                                    "$ref": "#/form/properties/details/properties/option_type"
                                                }
                                            ]
                                        },
                                        {
                                            "!=": [
                                                {
                                                    "$ref": "#/form/properties/details/properties/has_additional_option"
                                                },
                                                true
                                            ]
                                        }
                                    ]
                                }
                            }
                        },
                        "properties": {
                            "amount": {
                                "type": "number",
                                "title": "Amount",
                                "fieldType": "numberinput",
                                "condition": {
                                    "disabled": {
                                        "$evaluation": {
                                            "or": [
                                                {
                                                    "ISEMPTY": [
                                                        {
                                                            "$ref": "#/form/properties/details/properties/option_type"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "!=": [
                                                        {
                                                            "$ref": "#/form/properties/details/properties/has_additional_option"
                                                        },
                                                        true
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                },
                                "dependents": [
                                    {
                                        "$ref": "#/form/properties/details/properties/option_details/properties/fee",
                                        "value": {
                                            "$evaluation": {
                                                "*": [
                                                    {
                                                        "$ref": "$value"
                                                    },
                                                    0.05
                                                ]
                                            }
                                        }
                                    }
                                ]
                            },
                            "fee": {
                                "type": "number",
                                "title": "Fee Amount",
                                "fieldType": "numberinput",
                                "condition": {
                                    "disabled": true,
                                    "hidden": {
                                        "$evaluation": {
                                            "or": [
                                                {
                                                    "ISEMPTY": [
                                                        {
                                                            "$ref": "#/form/properties/details/properties/option_type"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "ISEMPTY": [
                                                        {
                                                            "$ref": "#/form/properties/details/properties/option_details/properties/amount"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    }
                                }
                            },
                            "custom_options": {
                                "type": "object",
                                "title": "Custom Options",
                                "$layout": {
                                    "type": "VerticalLayout",
                                    "elements": [
                                        {
                                            "$ref": "#/form/properties/details/properties/option_details/properties/custom_options/properties/option_a"
                                        },
                                        {
                                            "$ref": "#/form/properties/details/properties/option_details/properties/custom_options/properties/option_b"
                                        }
                                    ]
                                },
                                "condition": {
                                    "hidden": {
                                        "$evaluation": {
                                            "!=": [
                                                {
                                                    "$ref": "#/form/properties/details/properties/option_type"
                                                },
                                                "CUSTOM"
                                            ]
                                        }
                                    }
                                },
                                "properties": {
                                    "option_a": {
                                        "type": "string",
                                        "title": "Custom Option A",
                                        "fieldType": "textinput",
                                        "condition": {
                                            "disabled": {
                                                "$evaluation": {
                                                    "or": [
                                                        {
                                                            "!=": [
                                                                {
                                                                    "$ref": "#/form/properties/details/properties/option_type"
                                                                },
                                                                "CUSTOM"
                                                            ]
                                                        },
                                                        {
                                                            "!=": [
                                                                {
                                                                    "$ref": "#/form/properties/details/properties/has_additional_option"
                                                                },
                                                                true
                                                            ]
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    },
                                    "option_b": {
                                        "type": "boolean",
                                        "title": "Enable Option B",
                                        "fieldType": "checkbox",
                                        "condition": {
                                            "hidden": {
                                                "$evaluation": {
                                                    "or": [
                                                        {
                                                            "!=": [
                                                                {
                                                                    "$ref": "#/form/properties/details/properties/option_type"
                                                                },
                                                                "CUSTOM"
                                                            ]
                                                        },
                                                        {
                                                            "ISEMPTY": [
                                                                {
                                                                    "$ref": "#/form/properties/details/properties/option_details/properties/custom_options/properties/option_a"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            },
                                            "disabled": {
                                                "$evaluation": {
                                                    "or": [
                                                        {
                                                            "!=": [
                                                                {
                                                                    "$ref": "#/form/properties/details/properties/option_type"
                                                                },
                                                                "CUSTOM"
                                                            ]
                                                        },
                                                        {
                                                            "ISEMPTY": [
                                                                {
                                                                    "$ref": "#/form/properties/details/properties/option_details/properties/custom_options/properties/option_a"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "!=": [
                                                                {
                                                                    "$ref": "#/form/properties/details/properties/has_additional_option"
                                                                },
                                                                true
                                                            ]
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
